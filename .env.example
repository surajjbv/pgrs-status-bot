# Copy to .env and fill in. Personal values only; everything else is in config.json.
# .env is gitignored: your IDs and numbers never leave this Mac.

# WhatsApp group that gets the digest (exact name, case-insensitive)
GROUP_NAME=My Family Group

# 1. Karnataka IPGRS (https://ipgrs.karnataka.gov.in): grievance ID + registered mobile
IPGRS_ID=123456
IPGRS_MOBILE=9876543210
IPGRS_TITLE=KA Grievance

# 2. AP PGRS (https://pgrs.ap.gov.in): grievance number
PGRS_ID=XXXX000000000000
PGRS_TITLE=AP Grievance

# 3. AP eMunicipal property tax (https://emunicipal.ap.gov.in): ULB id + application number.
#    ULB ids: curl -s https://emunicipal.ap.gov.in/apiv1/erp-services/masters/ulb/list
EMUN_ULB_ID=1000
EMUN_APP=00000-2026-UB
EMUN_TITLE=Property Tax
