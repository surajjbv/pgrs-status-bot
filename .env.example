# Copy to .env and fill in. Personal values only; everything else is in config.json.
# .env is gitignored: your IDs and numbers never leave this Mac.

# WhatsApp group that gets the digest (exact name, case-insensitive)
GROUP_NAME=My Family Group

# The applications to check, one group of keys each, in the order the message lists them.
# Every group also takes (all optional):
#   _TITLE    name in the message (default: KA Grievance, AP Grievance, Property Tax)
#   _URL      link sent when something changes (default: the site's status page)
#   _ENABLED  false (or no/off/0) skips it until you set it back to true; the last result is kept
# More than one of a kind: add a number to the prefix, e.g. IPGRS2_ID, IPGRS2_MOBILE, IPGRS2_TITLE.
# Check one now, even if disabled: npm start -- --only=ipgrs2   (key = kind + number: ipgrs, pgrs, emunicipal)

# Karnataka IPGRS (https://ipgrs.karnataka.gov.in): grievance ID + registered mobile
IPGRS_ID=123456
IPGRS_MOBILE=9876543210
IPGRS_TITLE=KA Grievance
IPGRS_ENABLED=true

# AP PGRS (https://pgrs.ap.gov.in): grievance number
PGRS_ID=XXXX000000000000
PGRS_TITLE=AP Grievance
PGRS_URL=https://pgrs.ap.gov.in/ApplicationStatus.aspx

# AP eMunicipal property tax (https://emunicipal.ap.gov.in): ULB id + application number.
#    ULB ids: curl -s https://emunicipal.ap.gov.in/apiv1/erp-services/masters/ulb/list
EMUN_ULB_ID=1000
EMUN_APP=00000-2026-UB
EMUN_TITLE=Property Tax

# A second Karnataka grievance, switched off
IPGRS2_ID=654321
IPGRS2_MOBILE=9876500000
IPGRS2_TITLE=KA Grievance (old)
IPGRS2_ENABLED=false
